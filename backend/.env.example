# Runtime: least-privilege role, session pooler (see prisma/setup-app-role.ts)
DATABASE_URL="postgresql://genzhire_app.<project-ref>:<app-role-password>@<region>.pooler.supabase.com:5432/postgres?schema=genzhire&connection_limit=8"
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres?schema=genzhire"
NODE_ENV=development
PORT=3000
JWT_SECRET=<48+ random bytes, base64url>
CURSOR_SECRET=<32+ random bytes, base64url>
REQUIRE_EMAIL_VERIFICATION=false
STORAGE_DIR=./storage
COOKIE_SECURE=false
