generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model abuse_reports {
  id                                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id                            String?  @db.Uuid
  target_type                            String
  target_id                              String   @db.Uuid
  reason                                 String
  details                                String?
  status                                 String   @default("OPEN")
  handled_by                             String?  @db.Uuid
  resolution                             String?
  created_at                             DateTime @default(now()) @db.Timestamptz(6)
  users_abuse_reports_handled_byTousers  users?   @relation("abuse_reports_handled_byTousers", fields: [handled_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_abuse_reports_reporter_idTousers users?   @relation("abuse_reports_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model analytics_events {
  id           BigInt   @default(autoincrement())
  occurred_at  DateTime @db.Timestamptz(6)
  user_id      String?  @db.Uuid
  anonymous_id String?
  app          String
  event_name   String
  properties   Json     @default("{}")

  @@id([id, occurred_at])
}

model application_status_history {
  id             BigInt       @id @default(autoincrement())
  application_id String       @db.Uuid
  from_status    String?
  to_status      String
  changed_by     String?      @db.Uuid
  note           String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?       @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([application_id, created_at], map: "application_status_history_app_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model applications {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id                     String                       @db.Uuid
  employer_id                String                       @db.Uuid
  candidate_id               String                       @db.Uuid
  resume_id                  String?                      @db.Uuid
  resume_file_id             String                       @db.Uuid
  cover_note                 String?
  profile_snapshot           Json
  source                     String                       @default("DIRECT")
  status                     String                       @default("APPLIED")
  match_score                Int?                         @db.SmallInt
  applied_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  status_changed_at          DateTime                     @default(now()) @db.Timestamptz(6)
  application_status_history application_status_history[]
  candidates                 candidates                   @relation(fields: [candidate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employers                  employers                    @relation(fields: [employer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobs                       jobs                         @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files                      files                        @relation(fields: [resume_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resumes                    resumes?                     @relation(fields: [resume_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interviews                 interviews[]

  @@unique([job_id, candidate_id])
  @@index([candidate_id, applied_at(sort: Desc)], map: "applications_candidate_idx")
  @@index([employer_id, applied_at(sort: Desc)], map: "applications_employer_idx")
  @@index([job_id, status, applied_at(sort: Desc)], map: "applications_job_status_idx")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model audit_logs {
  id          BigInt   @default(autoincrement())
  actor_id    String?  @db.Uuid
  actor_role  String?
  actor_app   String?
  action      String
  entity_type String
  entity_id   String
  employer_id String?  @db.Uuid
  metadata    Json     @default("{}")
  ip_address  String?  @db.Inet
  user_agent  String?
  request_id  String?
  prev_hash   Bytes?
  hash        Bytes
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@id([id, created_at])
  @@index([action, created_at(sort: Desc)], map: "audit_logs_action_idx")
  @@index([actor_id, created_at(sort: Desc)], map: "audit_logs_actor_idx")
  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "audit_logs_entity_idx")
}

model candidate_blocked_employers {
  candidate_id String     @db.Uuid
  employer_id  String     @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  candidates   candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employers    employers  @relation(fields: [employer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "candidate_blocked_employers_employer_fk")

  @@id([candidate_id, employer_id])
}

model candidate_certifications {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id   String     @db.Uuid
  name           String
  issuer         String
